{
  "name": "trading-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --exit-child src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "create-token": "tsx scripts/create-collector-token.ts",
    "create-dashboard-token": "tsx scripts/create-dashboard-token.ts",
    "manage-rules": "tsx scripts/manage-rules.ts",
    "send-account-summary": "tsx scripts/send-account-summary.ts",
    "trigger-daily-analysis": "tsx scripts/trigger-daily-analysis.ts",
    "evaluate-autonomous-rule": "tsx scripts/evaluate-autonomous-rule.ts",
    "backtest-autonomous-rule": "tsx scripts/backtest-autonomous-rule.ts",
    "backtest-trend-breakout": "tsx scripts/backtest-trend-breakout.ts",
    "report-xauusd-coverage": "tsx scripts/report-xauusd-coverage.ts",
    "confirmed-retest:study": "tsx scripts/confirmed-retest-study.ts",
    "confirmed-retest:watch": "tsx scripts/confirmed-retest-watch.ts",
    "confirmed-retest:watcher": "tsx scripts/confirmed-retest-watch.ts --loop",
    "confirmed-retest-v2:study": "tsx scripts/confirmed-retest-v2-study.ts",
    "gold-execution:watch": "tsx scripts/gold-execution-watch.ts",
    "gold-execution:scheduler": "tsx scripts/gold-execution-scheduler.ts",
    "trend-breakout-execution:scheduler": "tsx scripts/trend-breakout-execution-scheduler.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test": "npm run test:db:up && vitest run",
    "test:watch": "npm run test:db:up && vitest",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "xauusd-m1m5:scheduler": "node dist/scripts/xauusd-m1m5-scheduler.js",
    "xauusd-rsi:scheduler": "tsx scripts/xauusd-rsi-scheduler.ts",
    "xauusd-rsi:migrate": "tsx scripts/xauusd-rsi-migrate.ts",
    "xauusd-rsi:telegram-test": "tsx scripts/xauusd-rsi-telegram-test.ts",
    "xauusd-rsi:verify-rsi": "tsx scripts/xauusd-rsi-verify-rsi.ts",
    "telegram:auth": "tsx scripts/telegram-auth.ts",
    "telegram:ingest": "tsx scripts/telegram-ingest.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "input": "^1.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegram": "^2.26.22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.1"
  }
}
